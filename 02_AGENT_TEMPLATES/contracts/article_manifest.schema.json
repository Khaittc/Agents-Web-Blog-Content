{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArticleManifestSchema",
  "description": "Packaging manifest generated by Packaging/Publisher Agent documenting all release assets, hashes, and deployment metadata",
  "type": "object",
  "required": [
    "article_id",
    "blog_type",
    "topic",
    "html_artifact_file",
    "content_sha256",
    "packaged_at",
    "packager",
    "target_cms",
    "sources_count",
    "claims_count",
    "associated_assets"
  ],
  "properties": {
    "article_id": {
      "type": "string"
    },
    "blog_type": {
      "type": "string",
      "enum": [
        "BLOG-T01",
        "BLOG-T02",
        "BLOG-T03",
        "BLOG-T04",
        "BLOG-T05"
      ]
    },
    "topic": {
      "type": "string"
    },
    "html_artifact_file": {
      "type": "string",
      "description": "Relative filename of the packaged CKEditor HTML artifact"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$",
      "description": "SHA-256 integrity hash of the packaged HTML content"
    },
    "packaged_at": {
      "type": "string",
      "format": "date-time"
    },
    "packager": {
      "type": "string",
      "default": "publisher_agent"
    },
    "target_cms": {
      "type": "string",
      "default": "CKEditor 3.6.6.2"
    },
    "package_version": {
      "type": "string",
      "default": "1.0"
    },
    "sources_count": {
      "type": "integer",
      "minimum": 1
    },
    "claims_count": {
      "type": "integer",
      "minimum": 1
    },
    "associated_assets": {
      "type": "array",
      "description": "List of all associated image/diagram files bundled with the package",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "file_name",
          "role",
          "aspect_ratio"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "FEATURED_IMAGE",
              "CONTENT_IMAGE",
              "DIAGRAM",
              "FLOWCHART"
            ]
          },
          "aspect_ratio": {
            "type": "string"
          },
          "pixel_dimensions": {
            "type": "string"
          },
          "file_sha256": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "manual_publish_notes": {
      "type": "string",
      "description": "Instructions for human editor performing manual upload and publishing to CMS"
    }
  },
  "additionalProperties": false
}
