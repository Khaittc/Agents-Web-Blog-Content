{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RevisionRequestSchema",
  "description": "Structured revision contract generated by Review Agent to request precise, scoped fixes from specific subagents",
  "type": "object",
  "required": [
    "article_id",
    "revision_loop",
    "max_retries",
    "overall_status",
    "gate",
    "created_at",
    "issues"
  ],
  "properties": {
    "article_id": {
      "type": "string"
    },
    "revision_loop": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "Current loop count (1 to 3 allowed automatically; loop 4 escalates to human)"
    },
    "max_retries": {
      "type": "integer",
      "default": 3
    },
    "gate": {
      "type": "string",
      "enum": [
        "TECHNICAL_REVIEW_GATE",
        "PRESENTATION_REVIEW_GATE"
      ]
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "REVISION_REQUIRED",
        "ESCALATED_TO_HUMAN"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "issues": {
      "type": "array",
      "description": "Targeted issues to be addressed. Assigned subagents must ONLY modify the specified scope.",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "severity",
          "owner",
          "artifact",
          "description",
          "required_action",
          "scope",
          "retry_count",
          "status"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^REV-[0-9]{3,}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "MINOR",
              "MAJOR",
              "BLOCKER"
            ]
          },
          "owner": {
            "type": "string",
            "enum": [
              "RESEARCH",
              "DRAFTING",
              "VISUAL",
              "PUBLISHER"
            ]
          },
          "artifact": {
            "type": "string",
            "description": "Target file to modify, e.g., draft_review_package.md"
          },
          "claim_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Target claim ID if relevant (e.g., CLM-003)"
          },
          "description": {
            "type": "string",
            "description": "Detailed explanation of the technical or presentation flaw"
          },
          "required_action": {
            "type": "string",
            "description": "Concrete action required to fix the issue"
          },
          "scope": {
            "type": "string",
            "description": "Boundary of modification. Strictly prohibits full article rewriting."
          },
          "retry_count": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "RESOLVED"
            ],
            "default": "OPEN"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
